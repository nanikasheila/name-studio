<?xml version="1.0" encoding="utf-8"?>
<!--
  What SignPath signs for name-studio (paste into the project's artifact
  configuration on signpath.io; promote.yml submits the artifact
  "unsigned-installer"). The artifact is the zip actions/upload-artifact makes
  with the one NSIS installer at its root. Only a file whose version
  information says it is Name Studio is signed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set product-name="Name Studio">
      <include path="NameStudio_*_x64-setup.exe" min-matches="1" max-matches="1" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
