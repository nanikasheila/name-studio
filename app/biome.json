{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "includes": ["**", "!src/generated/**"]
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "noFocusedTests": "off"
      },
      "correctness": {
        "noVoidTypeReturn": "off"
      },
      "complexity": {
        "noCommaOperator": "off"
      }
    }
  },
  "files": {
    "includes": ["src/**/*.ts", "e2e/**/*.mjs", "e2e/**/*.js", "vite.config.ts"]
  }
}
